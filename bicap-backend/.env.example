# ========================================
# BICAP Backend Environment Variables
# ========================================

# ----- Database Configuration -----
DB_SERVER=sql_server
DB_USER=sa
DB_PASSWORD=BiCapProject@123
DB_NAME=BICAP
DB_PORT=1433

# ----- Server Configuration -----
PORT=5001
NODE_ENV=development

# ----- Firebase Configuration -----
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ----- JWT Secret (for development) -----
JWT_SECRET=SECRET_KEY_123

# ----- Redis Configuration -----
# Option 1: Docker Redis (Default - Local Development)
# No configuration needed, uses default: redis://redis:6379

# Option 2: Redis Cloud (Production)
# Uncomment and fill in your Redis Cloud credentials:
# REDIS_HOST=redis-14671.c241.us-east-1-4.ec2.cloud.redislabs.com
# REDIS_PORT=14671
# REDIS_USERNAME=default
# REDIS_PASSWORD=FLOs8R0DYREkMOReH73VVVibBb9Mwfax

# Option 3: Redis URL format (Alternative)
# REDIS_URL=redis://:password@host:port

# ----- VNPay Configuration -----
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# ----- API URL -----
API_URL=http://localhost:5001
